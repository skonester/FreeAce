            </desktop5:ItemType>
            <desktop5:ItemType Type=".tgz">
              <desktop5:Verb Id="FreeAceExtractTgz" Clsid="B7E2A91C-6D4F-4A3E-9C1B-8F0E2D3A4B5D" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".bz2">
              <desktop5:Verb Id="FreeAceExtractBz2" Clsid="B7E2A91C-6D4F-4A3E-9C1B-8F0E2D3A4B5D" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".tbz2">
              <desktop5:Verb Id="FreeAceExtractTbz2" Clsid="B7E2A91C-6D4F-4A3E-9C1B-8F0E2D3A4B5D" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".xz">
