            <desktop5:ItemType Type=".rar">
              <desktop5:Verb Id="FreeAceExtractRar" Clsid="B7E2A91C-6D4F-4A3E-9C1B-8F0E2D3A4B5D" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".tar">
              <desktop5:Verb Id="FreeAceExtractTar" Clsid="B7E2A91C-6D4F-4A3E-9C1B-8F0E2D3A4B5D" />
